# OpenClaw is the default LLM backend. Leave the path empty when `openclaw`
# is available on PATH or at $HOME/.openclaw/bin/openclaw.
PAPER_MONITOR_OPENCLAW_PATH=
PAPER_MONITOR_OPENCLAW_AGENT=main
PAPER_MONITOR_LLM_BACKEND=openclaw_agent

# Feishu credentials are normally read from $HOME/.openclaw/openclaw.json.
# These variables are a fallback for document archiving.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Required by scripts/install_openclaw_jobs.sh. Use the Feishu group/chat ID,
# never a personal display name.
PAPER_MONITOR_FEISHU_TARGET=
PAPER_MONITOR_OPENCLAW_ACCOUNT_ID=
PAPER_MONITOR_OPENCLAW_CHANNEL=feishu
PAPER_MONITOR_OPENCLAW_MODEL=

# Optional. Anonymous Semantic Scholar requests still work at lower limits.
SEMANTIC_SCHOLAR_API_KEY=

PAPER_MONITOR_TIMEZONE=Asia/Shanghai
